# Pooja (HostelPGDekho.com) — environment template.
# Copy this file to `.env` and fill in only what you need for the mode
# you plan to run. Nothing here is required for `--mode offline`.

# --- Required for --mode text and --mode voice ---
# Groq (free credits on signup: https://console.groq.com)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Used only if the primary model above fails (one bounded attempt, never
# retried further). llama-3.3-70b-versatile was retired by Groq — using
# it returned 404 model_not_found in a real run of this project, so the
# default fallback is now openai/gpt-oss-20b (confirmed Production +
# tool-calling capable on Groq's docs as of 2026-10-17).
GROQ_MODEL_FALLBACK=openai/gpt-oss-20b
# Per-request timeout before Groq is considered unresponsive.
GROQ_REQUEST_TIMEOUT_S=20

# --- Required for --mode voice only ---
# Sarvam AI speech-to-text (free credits on signup: https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Cartesia text-to-speech (https://play.cartesia.ai) — MANDATORY by
# default for --mode voice (not a silent fallback). If this is missing
# or invalid, `python pooja_cli.py --mode voice` will refuse to start
# and tell you exactly what to fix, UNLESS you explicitly pass
# --tts-engine pyttsx3 (deliberately offline) or --allow-tts-fallback
# (per-turn fallback, always reported).
CARTESIA_API_KEY=
# Run 'python pooja_cli.py --find-voice' once CARTESIA_API_KEY is set to
# list Hindi, feminine-presenting voice ids from your own account and
# pick one — do not guess an id.
CARTESIA_VOICE_ID=
# Checked against the SDK installed by requirements.txt at the time this
# was written: valid ids were "sonic-3.5" (default here), "sonic-3",
# "sonic-3.5-2026-05-04", "sonic-3-2026-01-12", "sonic-3-2025-10-27",
# "sonic-latest". There is no "sonic-3.6" — see README for detail.
CARTESIA_MODEL_ID=sonic-3.5
# Cartesia language code for synthesis (supports Hindi "hi"; Hinglish
# text is spoken under the "hi" language setting).
CARTESIA_LANGUAGE=hi
# Speaking speed, per Cartesia's documented generation_config.speed field
# (sonic-3+ models only). Range [0.6, 1.5], default 1.0. >1.0 is faster.
# Never changes the voice itself (CARTESIA_VOICE_ID is untouched).
CARTESIA_SPEED=1.0

# --- Optional, all modes ---
# URL Pooja reads out when an owner asks for the app link (she can't
# actually send WhatsApp messages in this local demo).
HOSTELPGDEKHO_APP_URL=https://hostelpgdekho.com/app

# Safety net: force the call to wrap up after this many conversational
# turns even if no terminal state was reached.
POOJA_MAX_TURNS=20

# Force a specific VAD backend instead of auto-selecting the best
# available one (silero > webrtcvad > energy-threshold). Leave unset
# unless you're troubleshooting. Values: silero | webrtcvad | energy
POOJA_VAD_BACKEND=

# Microphone/speaker to use: a sounddevice index (e.g. "2") or a
# case-insensitive substring of the device name (e.g. "USB Microphone").
# Leave unset to use Windows' own default device. Run
# 'python pooja_cli.py --list-devices' to see exact names/indices, or
# '--mode voice' / '--diagnose' to see which device was actually picked.
POOJA_INPUT_DEVICE=
POOJA_OUTPUT_DEVICE=

# Listening timing — tune these instead of editing code if normal
# speaking pauses are getting cut off, or if Pooja starts listening too
# early/late. See README's STT section for what each one does.
POOJA_SILENCE_TIMEOUT_S=1.5
POOJA_PRE_SPEECH_TIMEOUT_S=8.0
POOJA_MAX_RECORD_S=20.0
POOJA_MIN_SPEECH_S=0.25
# RMS (0-32767 scale) below which a recording is treated as silence and
# never sent to Sarvam. Lower this if real speech is being skipped as
# "silent"; raise it if background noise is being sent as speech.
POOJA_SILENCE_RMS_THRESHOLD=80

# --- Web version (python web_server.py), see the README section "Share Pooja with Sir" ---
# Code a visitor must enter before they can start a call. SET THIS before making the page public:
# anyone with the link could otherwise spend your voice/AI credits.
POOJA_ACCESS_CODE=
# Calls allowed at the same time (protects your Groq/Cartesia limits) and the longest call, in seconds.
POOJA_MAX_CALLS=2
POOJA_WEB_MAX_CALL_S=420
# Timezone used for the greeting (good morning / afternoon / evening). Cloud servers run on UTC.
POOJA_TIMEZONE=Asia/Kolkata
# Port the web server listens on (hosts like Render set this for you).
PORT=8000
# Optional: how the voice says the brand name (Devanagari reads as one smooth name).
# POOJA_BRAND_SPOKEN=Hostel PG Dekho
